[Unit]
Description=btop on the landscape console (tty1)
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service

[Service]
User=phone
Environment=TERM=linux HOME=/home/phone
ExecStartPre=+-/bin/sh -c 'echo 1 > /sys/class/graphics/fbcon/rotate_all; setterm --blank 0 --powerdown 0 > /dev/tty1'
ExecStart=/usr/sbin/btop
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
