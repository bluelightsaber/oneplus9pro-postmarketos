@@ -24,6 +24,11 @@ enum qcom_battmgr_variant {
 #define BATTMGR_BAT_STATUS		0x1
 
 #define BATTMGR_REQUEST_NOTIFICATION	0x4
+#define BATTMGR_CHG_CTRL_LIMIT_EN	0x48
+#define CHARGE_CTRL_START_THR_MIN	40
+#define CHARGE_CTRL_START_THR_MAX	95
+#define CHARGE_CTRL_END_THR_MIN		50
+#define CHARGE_CTRL_END_THR_MAX		100
 
 #define BATTMGR_NOTIFICATION		0x7
 #define NOTIF_BAT_PROPERTY		0x30
@@ -52,6 +57,7 @@ enum qcom_battmgr_variant {
 #define BATT_CURR_NOW			9
 #define BATT_CHG_CTRL_LIM		10
 #define BATT_CHG_CTRL_LIM_MAX		11
+#define BATT_CHG_CTRL_EN		24
 #define BATT_TEMP			12
 #define BATT_TECHNOLOGY			13
 #define BATT_CHG_COUNTER		14
@@ -477,6 +483,90 @@ static int qcom_battmgr_bat_sc8280xp_update(struct qcom_battmgr *battmgr,
 	return ret;
 }
 
+struct qcom_battmgr_charge_ctrl_request {
+	struct pmic_glink_hdr hdr;
+	__le32 enable;
+	__le32 target_soc;
+	__le32 delta_soc;
+};
+
+/* single instance on this platform: keep the last thresholds sent to the firmware */
+static int chg_ctrl_start = CHARGE_CTRL_START_THR_MIN;
+static int chg_ctrl_end = CHARGE_CTRL_END_THR_MAX;
+static int chg_behaviour = POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+
+static int qcom_battmgr_set_charge_control(struct qcom_battmgr *battmgr, int start, int end)
+{
+	struct qcom_battmgr_charge_ctrl_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_CHG_CTRL_LIMIT_EN),
+		.enable = cpu_to_le32(1),
+		.target_soc = cpu_to_le32(end),
+		.delta_soc = cpu_to_le32(end - start),
+	};
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	mutex_unlock(&battmgr->lock);
+	if (!ret) {
+		chg_ctrl_start = start;
+		chg_ctrl_end = end;
+	}
+	return ret;
+}
+
+static int qcom_battmgr_bat_is_writeable(struct power_supply *psy,
+					 enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR;
+}
+
+static int qcom_battmgr_bat_set_property(struct power_supply *psy,
+					 enum power_supply_property psp,
+					 const union power_supply_propval *pval)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	int start = chg_ctrl_start, end = chg_ctrl_end;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR: {
+		int ret;
+
+		if (pval->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+		    pval->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)
+			return -EINVAL;
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+						    BATT_CHG_CTRL_EN,
+						    pval->intval == POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO);
+		mutex_unlock(&battmgr->lock);
+		if (!ret)
+			chg_behaviour = pval->intval;
+		return ret;
+	}
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		start = clamp(pval->intval, CHARGE_CTRL_START_THR_MIN, CHARGE_CTRL_START_THR_MAX);
+		if (end <= start)
+			end = min(start + 5, CHARGE_CTRL_END_THR_MAX);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		end = clamp(pval->intval, CHARGE_CTRL_END_THR_MIN, CHARGE_CTRL_END_THR_MAX);
+		if (start >= end)
+			start = max(end - 5, CHARGE_CTRL_START_THR_MIN);
+		break;
+	default:
+		return -EINVAL;
+	}
+	return qcom_battmgr_set_charge_control(battmgr, start, end);
+}
+
