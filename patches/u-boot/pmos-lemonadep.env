bootdelay=1
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=
pmos_bootargs=initcall_blacklist=disp_cc_sm8250_driver_init initcall_blacklist=eth_driver_init rd.rootfs=super:4096 fw_devlink=permissive clk_ignore_unused pd_ignore_unused loglevel=7 console=tty0 pmos.nosplash pmos_boot_uuid=<BOOT_FS_UUID> pmos_root_uuid=<ROOT_FS_UUID> pmos_rootfsopts=subvol=@,notreelog,compress=zstd:2,ssd
boot_abl_fit=echo ABL initrd: ${prevbl_initrd_start} - ${prevbl_initrd_end}; if test -z "${prevbl_initrd_start}"; then echo No ABL initrd info; else for off in 0x0 0x1721df4 0x1722000; do setexpr fit_addr ${prevbl_initrd_start} + ${off}; echo Trying FIT at ${fit_addr}; md.b ${fit_addr} 8; cp.b ${fit_addr} ${ramdisk_addr_r} 0x6000000; if iminfo ${ramdisk_addr_r}; then setenv bootargs ${pmos_bootargs}; bootm ${ramdisk_addr_r}; fi; done; fi; echo No bootable FIT found
bootcmd=run boot_abl_fit; pause; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot pmOS FIT=run boot_abl_fit; pause
bootmenu_1=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Board info=bdinfo; pause
bootmenu_4=Dump environment=printenv; pause
bootmenu_5=Reset device=reset
bootmenu_6=Power off=poweroff
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
