From 870f63679635ffbacd7434dec4ac148ae380c982 Mon Sep 17 00:00:00 2001
From: bluelightsaber <bluelightsaber@users.noreply.github.com>
Date: Fri, 9 Oct 2026 08:20:39 +0200
Subject: [PATCH] WIP: drm/panel: Samsung AMB670YF01 (OnePlus 9 Pro) + display
 DT + sm8350 MDSS SMMU identity

- panel-samsung-amb670yf01: generated with linux-mdss-dsi-panel-driver-generator from the vendor
  (LineageOS dtbo) node; vendor PPS (0x9e) replaced by the kernel-computed PPS; DISPLAY_ON in .enable;
  DCS power mode readback for debugging.
- sm8350-oneplus-lemonadep: enable MDSS, DSI0 + PHY, panel node (reset gpio24, TE gpio82,
  vddio L12C, vci L13C).
- iommu/arm-smmu-qcom: add qcom,sm8350-mdss to qcom_smmu_client_of_match (identity default domain,
  like sm8150/sm8250/sm8450), otherwise the bootloader scanout faults once MDSS is enabled.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     |  53 ++
 drivers/gpu/drm/panel/Kconfig                 |  11 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../gpu/drm/panel/panel-samsung-amb670yf01.c  | 454 ++++++++++++++++++
 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c    |   1 +
 5 files changed, 520 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-amb670yf01.c

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 713dc08e6..524d26c96 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -18,3 +18,56 @@ &mpss {
 	pinctrl-0 = <&rf_cable_ant0_active>;
 	pinctrl-names = "default";
 };
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm8350_l6>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "samsung,amb670yf01";
+		reg = <0>;
+
+		vddio-supply = <&pm8350c_l12>;
+		vci-supply = <&pm8350c_l13>;
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&panel_reset_n &mdp_vsync_active>;
+		pinctrl-names = "default";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&pm8350_l5>;
+	status = "okay";
+};
+
+&tlmm {
+	panel_reset_n: panel-reset-n-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	mdp_vsync_active: mdp-vsync-active-state {
+		pins = "gpio82";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
