+
+static int samsung_amb670yf01_dsc_off(struct samsung_amb670yf01_dsc *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 21);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 101);
+
+	return dsi_ctx.accum_err;
+}
+
+static int samsung_amb670yf01_dsc_prepare(struct drm_panel *panel)
+{
+	struct samsung_amb670yf01_dsc *ctx = to_samsung_amb670yf01_dsc(panel);
+	struct device *dev = &ctx->dsi->dev;
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(samsung_amb670yf01_dsc_supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	samsung_amb670yf01_dsc_reset(ctx);
+
+	ret = samsung_amb670yf01_dsc_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(samsung_amb670yf01_dsc_supplies), ctx->supplies);
+		return ret;
+	}
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	print_hex_dump(KERN_INFO, "amb670yf01 pps: ", DUMP_PREFIX_OFFSET, 16, 1, &pps, sizeof(pps), false);
+
+	ret = mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to transmit PPS: %d\n", ret);
+		return ret;
+	}
+
+	ret = mipi_dsi_compression_mode(ctx->dsi, true);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable compression mode: %d\n", ret);
+		return ret;
+	}
+
+	msleep(28); /* TODO: Is this panel-dependent? */
+	amb670_log_power_mode(ctx, "after prepare");
+
+	return 0;
+}
+
+static int samsung_amb670yf01_dsc_unprepare(struct drm_panel *panel)
+{
+	struct samsung_amb670yf01_dsc *ctx = to_samsung_amb670yf01_dsc(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = samsung_amb670yf01_dsc_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(samsung_amb670yf01_dsc_supplies), ctx->supplies);
+
+	return 0;
+}
+
+/* Debug: downstream ESD check reads DCS 0x0a and expects 0x9f (booster, normal mode, sleep out, display on) */
+static void amb670_log_power_mode(struct samsung_amb670yf01_dsc *ctx, const char *when)
+{
+	u8 mode = 0;
+	int ret;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_get_power_mode(ctx->dsi, &mode);
+	dev_info(&ctx->dsi->dev, "power mode %s: ret=%d mode=0x%02x\n", when, ret, mode);
+}
+
+/*
+ * Downstream sends DISPLAY_ON (0x29) separately, as qcom,mdss-dsi-post-on-backlight, after the first
+ * frame/brightness update; it is not part of the on-command sequence (without it the screen stays black).
+ */
+static int samsung_amb670yf01_dsc_enable(struct drm_panel *panel)
+{
+	struct samsung_amb670yf01_dsc *ctx = to_samsung_amb670yf01_dsc(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	if (!dsi_ctx.accum_err)
+		dev_info(&ctx->dsi->dev, "display on\n");
+	msleep(20);
+	amb670_log_power_mode(ctx, "after display on");
+
+	return dsi_ctx.accum_err;
+}
+
+static int samsung_amb670yf01_dsc_disable(struct drm_panel *panel)
+{
+	struct samsung_amb670yf01_dsc *ctx = to_samsung_amb670yf01_dsc(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode samsung_amb670yf01_dsc_mode = {
+	.clock = (1080 + 64 + 8 + 50) * (2412 + 2 + 2 + 8) * 120 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 64,
+	.hsync_end = 1080 + 64 + 8,
+	.htotal = 1080 + 64 + 8 + 50,
+	.vdisplay = 2412,
+	.vsync_start = 2412 + 2,
+	.vsync_end = 2412 + 2 + 2,
+	.vtotal = 2412 + 2 + 2 + 8,
+	.width_mm = 73,
+	.height_mm = 160,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int samsung_amb670yf01_dsc_get_modes(struct drm_panel *panel,
+					    struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &samsung_amb670yf01_dsc_mode);
+}
+
+static const struct drm_panel_funcs samsung_amb670yf01_dsc_panel_funcs = {
+	.prepare = samsung_amb670yf01_dsc_prepare,
+	.enable = samsung_amb670yf01_dsc_enable,
+	.disable = samsung_amb670yf01_dsc_disable,
+	.unprepare = samsung_amb670yf01_dsc_unprepare,
+	.get_modes = samsung_amb670yf01_dsc_get_modes,
+};
+
+static int samsung_amb670yf01_dsc_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+// TODO: Check if /sys/class/backlight/.../actual_brightness actually returns
+// correct values. If not, remove this function.
+static int samsung_amb670yf01_dsc_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops samsung_amb670yf01_dsc_bl_ops = {
+	.update_status = samsung_amb670yf01_dsc_bl_update_status,
+	.get_brightness = samsung_amb670yf01_dsc_bl_get_brightness,
+};
+
+static struct backlight_device *
+samsung_amb670yf01_dsc_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 4095,
+		.max_brightness = 4095,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &samsung_amb670yf01_dsc_bl_ops, &props);
+}
+
+static int samsung_amb670yf01_dsc_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct samsung_amb670yf01_dsc *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct samsung_amb670yf01_dsc, panel,
+				   &samsung_amb670yf01_dsc_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(samsung_amb670yf01_dsc_supplies),
+					    samsung_amb670yf01_dsc_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = samsung_amb670yf01_dsc_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only supports DSC; unconditionally enable it */
+	dsi->dsc = &ctx->dsc;
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+
+	/* TODO: Pass slice_per_pkt = 2 */
+	ctx->dsc.slice_height = 36;
+	ctx->dsc.slice_width = 540;
+	/*
+	 * TODO: hdisplay should be read from the selected mode once
+	 * it is passed back to drm_panel (in prepare?)
+	 */
+	WARN_ON(1080 % ctx->dsc.slice_width);
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 10;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void samsung_amb670yf01_dsc_remove(struct mipi_dsi_device *dsi)
+{
+	struct samsung_amb670yf01_dsc *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id samsung_amb670yf01_dsc_of_match[] = {
+	{ .compatible = "samsung,amb670yf01" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, samsung_amb670yf01_dsc_of_match);
+
+static struct mipi_dsi_driver samsung_amb670yf01_dsc_driver = {
+	.probe = samsung_amb670yf01_dsc_probe,
+	.remove = samsung_amb670yf01_dsc_remove,
+	.driver = {
+		.name = "panel-samsung-amb670yf01-dsc",
+		.of_match_table = samsung_amb670yf01_dsc_of_match,
+	},
+};
+module_mipi_dsi_driver(samsung_amb670yf01_dsc_driver);
+
+MODULE_AUTHOR("OnePlus 9 Pro mainline port");
+MODULE_DESCRIPTION("DRM driver for samsung amb670yf01 dsc cmd mode panel");
+MODULE_LICENSE("GPL");
